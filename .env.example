# Every variable the Node entry point (apps/api/src/node.ts) reads; apps/api/src/env.ts refuses
# to boot if a required one is missing. The Worker entry point validates GIT_SHA from its
# Cloudflare binding through the same schema. Copy to .env for local runs outside compose.

# Postgres connection string. Required.
DATABASE_URL=postgres://desk:desk@localhost:5432/desk

# Port the Node entry point listens on. Optional, default 3000.
PORT=3000

# Git SHA baked into the build and reported by /healthz. Optional, default "unknown".
GIT_SHA=

# 32-byte base64 secret signing session cookies. Required.
SESSION_SECRET=

# 32-byte base64 key for AES-256-GCM sealing of stored provider tokens (SecretBox). Required.
SECRET_BOX_KEY=

# Resend API key for transactional mail in production. Optional; falls back to SMTP_URL.
RESEND_API_KEY=

# Sender for all mail, e.g. "Desk <noreply@yourdomain>". Must be on a domain verified in Resend;
# onboarding@resend.dev works for testing but only delivers to the Resend account's own address.
MAIL_FROM=

# SMTP URL for local/dev mail capture (Mailpit in compose). Optional; falls back to Resend.
SMTP_URL=smtp://localhost:1025

# Google OAuth client id/secret for "Sign in with Google" (openid email profile only). Optional as a pair.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google OAuth client id/secret for mail and calendar panels (mail/calendar scopes). Optional as a pair.
GOOGLE_PANELS_CLIENT_ID=
GOOGLE_PANELS_CLIENT_SECRET=

# Google API base URL for panels; defaults to https://www.googleapis.com. Optional.
GOOGLE_API_BASE=

# Google OAuth endpoint base URL for mocking in tests/compose; when unset, uses production endpoints.
# Defaults to https://accounts.google.com for authorize, https://oauth2.googleapis.com for token/revoke. Optional.
GOOGLE_OAUTH_BASE=

# Overrides only the authorize URL's base (the one redirected to in the browser); GOOGLE_OAUTH_BASE
# is still used for token/revoke. Needed when GOOGLE_OAUTH_BASE is a docker-network hostname (e.g.
# compose's `mocks`) the host browser can't resolve. Optional; falls back to GOOGLE_OAUTH_BASE.
GOOGLE_OAUTH_BROWSER_BASE=

# Microsoft OAuth client id/secret for mail and calendar panels (mail/calendar scopes). Optional as a pair.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Microsoft Graph API base URL for panels; defaults to https://graph.microsoft.com. Optional.
GRAPH_API_BASE=

# Microsoft OAuth endpoint base URL for mocking in tests/compose; when unset, uses production endpoints.
# Defaults to https://login.microsoftonline.com/common/oauth2/v2.0 for authorize/token. Optional.
MICROSOFT_LOGIN_BASE=

# Overrides only the authorize URL's base, same reason as GOOGLE_OAUTH_BROWSER_BASE above.
# Optional; falls back to MICROSOFT_LOGIN_BASE.
MICROSOFT_LOGIN_BROWSER_BASE=

# CalDAV test server URL for testing calendar connectors. Optional.
CALDAV_TEST_URL=

# IMAP test server host for testing mail connectors. Optional.
IMAP_TEST_HOST=

# T070/FR-017: set to "true" only in infra/docker-compose.yml, so e2e-ci's standards form can
# reach the `mocks` service's IMAP/CalDAV endpoints at their private Docker address — every other
# host/port/scheme rule in createStandards still applies. Off (anything but "true") everywhere
# else; refused at startup if NODE_ENV=production. Optional.
STANDARDS_ALLOW_PRIVATE_HOSTS=

# Notion public OAuth client id/secret for the optional two-way sync. Optional as a pair.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Points the Notion connector at infra/mocks instead of api.notion.com — set by docker-compose;
# leave unset in production.
NOTION_API_BASE=
# Unset = real hosts (api.open-meteo.com, geocoding-api.open-meteo.com); set = both go to <base>/v1/...
OPEN_METEO_API_BASE=

# Public origin the app is served from (cookie domain, OAuth redirect, CORS). Required.
APP_ORIGIN=http://localhost:5173

# Optional. Comma list of flag keys switched on globally at startup (Fly node entry only).
# deploy-preview.yml sets it so PR previews show flagged features; refused on ros-desk-production.
# FLAGS_ON=widgets.currency,widgets.weather

# Optional. Sign-ups allowed per IP per hour; defaults to 20. Raise only for test stacks (compose sets 1000).
# REGISTER_IP_LIMIT_PER_HOUR=20

# RATES_PROVIDER=fake selects the deterministic FakeRates instead of the real frankfurter.app
# client — set by infra/docker-compose.yml for e2e-ci. Optional, defaults to the real client.
RATES_PROVIDER=

# Sentry DSN for error reporting (adapters/logger-node.ts, adapters/logger-worker.ts). Optional —
# both adapters are pass-through no-ops without it; Sentry is never required to boot.
SENTRY_DSN=

# Owner inbox for the daily feedback digest job (jobs/feedback-digest.ts). Optional — the job
# skips sending when unset.
FEEDBACK_DIGEST_EMAIL=

# --- infra/fly/backup.sh (nightly pg_dump to Cloudflare R2) — Stage 1/beta infra, configured by
# Rostom later. All optional/commented; the script is a no-op without them.
# R2 (S3-compatible) endpoint, e.g. https://<account_id>.r2.cloudflarestorage.com
# R2_ENDPOINT=
# R2_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
