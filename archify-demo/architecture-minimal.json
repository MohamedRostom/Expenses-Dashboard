  "cards": [
    {
      "dot": "cyan",
      "title": "Two-Stage Deployment",
      "items": [
        "Stage 1: Fly.io container (Node entry) — free tier, preview per PR",
        "Stage 2: Cloudflare Workers + Pages + KV + Cron — global, paid",
        "Same Hono app, different adapters (node.ts / worker.ts)",
        "Neon Postgres both stages; Stage 2 via Hyperdrive"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared Packages (No I/O in core)",
      "items": [
        "core: Money (integer minor units), conversion, budgets, sync diff",
        "contracts: Zod schemas → OpenAPI + shared TS types",
        "ui: Design tokens (IBM Plex), base components, charts (SVG)",
        "connectors: Real client + fake + recorded fixtures each"
      ]
    },
    {
      "dot": "rose",
      "title": "Security & Isolation",
      "items": [
        "Server-side sessions (Postgres → KV), HTTP-only cookies, CSRF",
        "Argon2id passwords, Google OIDC (openid email profile only)",
        "Connector tokens encrypted at rest (AES-256-GCM via SecretBox)",
        "Row-level isolation: every entity has userId, ownership matrix tested"
      ]
    },
    {
      "dot": "amber",
      "title": "Feature Flags Gate Rollout",
      "items": [
        "flags table + user_flags — per-request evaluation",
        "panels.today, panels.google_calendar, panels.google_mail, panels.microsoft, panels.standards",
        "widgets.currency, widgets.weather, widgets.spend_pace, widgets.fixed_costs, widgets.sunrise",
        "All off in production until gates pass"
      ]
    },
    {
      "dot": "violet",
      "title": "v1 Scope → v2 Expansion",
      "items": [
        "v1 (Phases 0-4): Accounts, Currency, Expenses, Notion Sync, Webhooks, PWA, Landing",
        "v2 (Spec 002): Mail & Calendar panels — Google, Microsoft, Standards-based",
        "v2 (Spec 003): Dashboard widgets — Currency, Weather, Spend pace, Fixed costs, Sunrise",
        "Bank feeds via open banking — future ADR (ADR-0003 excludes from v1)"
      ]
    }
  ]
