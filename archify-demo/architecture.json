  "cards": [
    {
      "dot": "cyan",
      "title": "One app, two runtimes",
      "items": [
        "createApp() is shared; node.ts and worker.ts only swap adapters",
        "Node: Postgres sessions, in-process 30 s job tick, Fly machine as safety net",
        "Worker: KV sessions, Hyperdrive, cron */5; Notion and Google not wired yet"
      ]
    },
    {
      "dot": "emerald",
      "title": "Pure shared packages",
      "items": [
        "core: Money in minor units, conversion, budgets, sync diff — no I/O",
        "contracts: zod schemas → generated openapi.json",
        "db: Drizzle schema, SQL migrations, flags"
      ]
    },
    {
      "dot": "rose",
      "title": "Security baseline",
      "items": [
        "HTTP-only session cookie + CSRF double-submit",
        "Argon2id passwords, Google OIDC openid email profile only",
        "Connector tokens sealed by SecretBox; per-user ownership tests"
      ]
    },
    {
      "dot": "amber",
      "title": "Behind flags, off in production",
      "items": [
        "panels.* — mail and calendar panels (Google mail gated on CASA)",
        "widgets.* — currency, weather, spend pace, fixed costs, sunrise"
      ]
    }
  ]
