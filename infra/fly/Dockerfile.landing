# Build context is the repository root:
#   docker build -f infra/fly/Dockerfile.landing .
# Static landing site (apps/landing, vite-ssg) served by nginx. Separate from Dockerfile
# (the api+web image) since it deploys as its own Fly app, gated by LANDING_ENABLED.

FROM node:22-bookworm-slim AS build
RUN npm install -g pnpm@12.4.2
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @desk/landing build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/apps/landing/dist /usr/share/nginx/html
EXPOSE 80
