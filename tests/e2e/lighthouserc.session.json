{
  "ci": {
    "collect": {
      "url": ["http://localhost:4173/", "http://localhost:4173/settings"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:4173/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.69 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:pwa": ["warn", { "minScore": 0.8 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4173/settings$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.86 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:pwa": ["warn", { "minScore": 0.8 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-reports/session"
    }
  }
}
